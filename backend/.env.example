PORT=5000
MONGODB_URI=mongodb://localhost:27017/raise_platform

# Environment Mode: 'local' for SMTP (Gmail), 'production' for Brevo
APP_ENVIRONMENT=local

# Default Super Admin Seed Configuration
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="superadmin@raise.com"
SUPER_ADMIN_PASSWORD="Admin@12345"

# JWT Configuration
JWT_SECRET="your_super_secret_jwt_key_here_please_change_in_production"
JWT_EXPIRES_IN="7d"

# Local SMTP Configuration (Used when APP_ENVIRONMENT=local)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="Raise Platform" <no-reply@raiseplatform.com>

# Brevo Configuration (Used when APP_ENVIRONMENT=production)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_NAME="Raise Platform"
BREVO_SENDER_EMAIL=no-reply@yourdomain.com

# Optional: Brevo SMTP Alternative
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_login
BREVO_SMTP_PASS=your_brevo_smtp_key
